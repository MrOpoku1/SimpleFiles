<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ══ Storage permissions ══════════════════════════════════════════════ -->

    <!-- API 24–32: classic read permission -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- API 33+: granular media permissions -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <!-- API 24–28: write permission needed for file deletion -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- ════════════════════════════════════════════════════════════════════ -->

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/logo"
        android:supportsRtl="true"
        android:requestLegacyExternalStorage="true"
        android:theme="@style/Theme.SimpleFiles">

        <!-- ── Existing activities (unchanged) ──────────────────────────── -->

        <activity
            android:name=".HubActivity"
            android:exported="true"
            android:label="@string/title_activity_main"
            android:theme="@style/Theme.SimpleFiles.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".CustomizationMenu" />
        <activity android:name=".CustomizeNavActivity" />
        <activity
            android:name=".ViewTextFile"
            android:theme="@style/Theme.SimpleFiles.NoActionBar" />

        <!-- ── New: File Browser ─────────────────────────────────────────── -->

        <activity
            android:name=".FileBrowserActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:label="Files"
            android:theme="@style/Theme.SimpleFiles.NoActionBar" />

        <!-- FileProvider for sharing files via intent -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>