<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ══ Storage permissions ══════════════════════════════════════════════ -->

    <!-- API 24–32: classic read permission -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- API 33+: granular media permissions -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <!-- ════════════════════════════════════════════════════════════════════ -->

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.SimpleFiles">

        <!-- ── Existing activities (unchanged) ──────────────────────────── -->

        <activity
            android:name=".HubActivity"
            android:exported="true"
            android:label="@string/title_activity_main"
            android:theme="@style/Theme.SimpleFiles.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".CustomizationMenu" />
        <activity android:name=".CustomizeNavActivity" />
        <activity android:name=".ViewTextFile" />

        <!-- ── New: File Browser ─────────────────────────────────────────── -->

        <activity
            android:name=".FileBrowserActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:label="Files"
            android:theme="@style/Theme.SimpleFiles.NoActionBar" />

    </application>

</manifest>