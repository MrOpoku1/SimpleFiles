<?xml version="1.0" encoding="utf-8"?>
<!--
    app/src/main/res/values/themes.xml
    Merge with your existing themes.xml — keep any styles already there.
-->
<resources>

    <!-- Base app theme (already exists — shown here for context) -->
    <style name="Theme.SimpleFiles" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/color_primary</item>
        <item name="colorPrimaryDark">@color/color_primary_dark</item>
        <item name="colorAccent">@color/color_accent</item>
        <item name="android:windowBackground">@color/bg_primary</item>
    </style>

    <!-- Used by HubActivity (already declared in manifest) -->
    <style name="Theme.SimpleFiles.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- ── ADD ONLY THE STYLE BELOW IF YOU ALREADY HAVE THE ABOVE ── -->

    <!-- Toolbar popup menu style (makes sort dialog match Material theme) -->
    <style name="SimpleFiles.PopupMenu" parent="Widget.MaterialComponents.PopupMenu">
        <item name="android:textColor">@color/text_primary</item>
    </style>

</resources>