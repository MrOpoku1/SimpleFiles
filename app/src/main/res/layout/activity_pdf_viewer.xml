<?xml version="1.0" encoding="utf-8"?>
<!--
    app/src/main/res/layout/activity_pdf_viewer.xml
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#242222">

    <!-- ── Top annotation toolbar ────────────────────────────────────────── -->
    <HorizontalScrollView
        android:id="@+id/toolbar_annotation"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#B49191"
        android:scrollbars="none"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <!-- Mode: Highlight -->
            <ImageButton
                android:id="@+id/btn_highlight"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_highlight"
                android:contentDescription="Highlight mode"
                android:layout_marginEnd="4dp" />

            <!-- Mode: Freehand -->
            <ImageButton
                android:id="@+id/btn_freehand"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_freehand"
                android:contentDescription="Freehand draw mode"
                android:layout_marginEnd="4dp" />

            <!-- Mode: Text Note -->
            <ImageButton
                android:id="@+id/btn_note"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_note"
                android:contentDescription="Text note mode"
                android:layout_marginEnd="12dp" />

            <!-- Divider -->
            <View
                android:layout_width="1dp"
                android:layout_height="32dp"
                android:background="#80000000"
                android:layout_marginEnd="12dp" />

            <!-- Color: Yellow -->
            <ImageButton
                android:id="@+id/btn_color_yellow"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/ic_color_circle_yellow"
                android:contentDescription="Yellow"
                android:layout_marginEnd="8dp" />

            <!-- Color: Red -->
            <ImageButton
                android:id="@+id/btn_color_red"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/ic_color_circle_red"
                android:contentDescription="Red"
                android:layout_marginEnd="8dp" />

            <!-- Color: Blue -->
            <ImageButton
                android:id="@+id/btn_color_blue"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/ic_color_circle_blue"
                android:contentDescription="Blue"
                android:layout_marginEnd="12dp" />

            <!-- Divider -->
            <View
                android:layout_width="1dp"
                android:layout_height="32dp"
                android:background="#80000000"
                android:layout_marginEnd="12dp" />

            <!-- Undo -->
            <ImageButton
                android:id="@+id/btn_undo"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_revert"
                android:contentDescription="Undo"
                android:layout_marginEnd="4dp" />

            <!-- Save -->
            <ImageButton
                android:id="@+id/btn_save"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_save"
                android:contentDescription="Save annotations" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- ── PDF page + annotation overlay (stacked) ───────────────────────── -->
    <ScrollView
        android:id="@+id/scroll_pdf"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#242222"
        app:layout_constraintTop_toBottomOf="@+id/toolbar_annotation"
        app:layout_constraintBottom_toTopOf="@+id/bottom_nav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Rendered PDF page bitmap -->
            <ImageView
                android:id="@+id/iv_pdf_page"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:scaleType="fitStart"
                android:contentDescription="PDF page" />

            <!-- Annotation drawing layer (transparent, sits on top) -->
            <com.example.simplefiles.AnnotationOverlayView
                android:id="@+id/annotation_overlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </FrameLayout>
    </ScrollView>

    <!-- ── Bottom: page navigation ───────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#B49191"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btn_prev"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_media_previous"
            android:contentDescription="Previous page" />

        <TextView
            android:id="@+id/tv_page_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:text="1 / 1" />

        <ImageButton
            android:id="@+id/btn_next"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_media_next"
            android:contentDescription="Next page" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>