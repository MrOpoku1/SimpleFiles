<?xml version="1.0" encoding="utf-8"?>
<!--
    app/src/main/res/layout/item_file.xml
    Replace your existing item_file.xml with this.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="0dp"
    android:layout_marginEnd="0dp"
    android:layout_marginTop="8dp">

    <androidx.cardview.widget.CardView
        android:id="@+id/card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/lightPink"
        app:cardCornerRadius="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="200dp">

            <!-- Thumbnail / icon on the left -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/thumbnail"
                android:layout_width="127dp"
                android:layout_height="179dp"
                android:layout_marginStart="16dp"
                android:scaleType="centerCrop"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearanceOverlay="@style/RoundedCorners"
                tools:ignore="ContentDescription" />

            <!-- Emoji type icon — shown when no image thumbnail is available -->
            <TextView
                android:id="@+id/tv_icon"
                android:layout_width="127dp"
                android:layout_height="179dp"
                android:layout_marginStart="16dp"
                android:gravity="center"
                android:textSize="48sp"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Right-side content column -->
            <LinearLayout
                android:id="@+id/linearLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/thumbnail"
                app:layout_constraintTop_toTopOf="@+id/thumbnail">

                <!-- File name -->
                <TextView
                    android:id="@+id/tv_name"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:ellipsize="end"
                    android:fontFamily="serif"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:textColor="@color/black"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    tools:text="document.pdf" />

                <!-- Last modified date -->
                <TextView
                    android:id="@+id/tv_date"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textColor="@color/black"
                    tools:text="Apr 28, 2026" />

                <!-- File size -->
                <TextView
                    android:id="@+id/tv_size"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    tools:text="2.4 MB" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="10dp" />

                <!-- Divider -->
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/black"
                    android:contentDescription="divider" />

            </LinearLayout>

            <!-- Action buttons row (share, delete, favourite) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="66dp"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="@+id/thumbnail"
                app:layout_constraintEnd_toEndOf="@+id/linearLayout"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toEndOf="@+id/thumbnail"
                app:layout_constraintTop_toTopOf="@id/linearLayout"
                app:layout_constraintVertical_bias="0.946">

                <!-- Share -->
                <ImageButton
                    android:id="@+id/btn_share"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@color/lightPink"
                    android:scaleType="centerInside"
                    android:contentDescription="Share"
                    app:srcCompat="@android:drawable/ic_menu_share" />

                <!-- Delete -->
                <ImageButton
                    android:id="@+id/btn_delete"
                    android:layout_width="10dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@color/lightPink"
                    android:scaleType="fitCenter"
                    android:contentDescription="Delete"
                    android:src="@drawable/trashbutton" />

                <!-- Favourite / star -->
                <ImageButton
                    android:id="@+id/btn_star"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@color/lightPink"
                    android:scaleType="fitStart"
                    android:contentDescription="Favourite"
                    android:src="@android:drawable/btn_star_big_off" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>