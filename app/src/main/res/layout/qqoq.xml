<?xml version="1.0" encoding="utf-8"?>
<!-- item_book.xml — Drop this in res/layout/ and use it in your RecyclerView adapter -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="#1E2430"
    app:cardCornerRadius="10dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="4dp">

        <!-- Top row: Cover + Book info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp">

            <!-- Book Cover Thumbnail -->
            <ImageView
                android:id="@+id/ivBookCover"
                android:layout_width="72dp"
                android:layout_height="100dp"
                android:contentDescription="Book cover"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_launcher_background" />

            <!-- Book Details -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvBookTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="The Call of the Wild"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvBookAuthor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Jack London"
                    android:textColor="#B0B8C8"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvBookMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="EPUB, 196 KB"
                    android:textColor="#8892A4"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="12dp"
            android:background="#2E3648" />

        <!-- Bottom action bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <!-- Favourite -->

            <!-- History / Recent -->
            <ImageButton
                android:id="@+id/btnHistory"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Reading history"
                android:src="@android:drawable/ic_menu_recent_history"
                android:tint="#8892A4" />

            <!-- Read / Checkmark -->
            <ImageButton
                android:id="@+id/btnMarkRead"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Mark as read"
                android:src="@android:drawable/checkbox_on_background"
                android:tint="#8892A4" />

            <!-- Shelf / Library -->
            <ImageButton
                android:id="@+id/btnShelf"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Add to shelf"
                android:src="@android:drawable/ic_menu_agenda"
                android:tint="#8892A4" />

            <!-- More options -->
            <ImageButton
                android:id="@+id/btnMore"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="More options"
                android:src="@android:drawable/ic_menu_more"
                android:tint="#8892A4" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>